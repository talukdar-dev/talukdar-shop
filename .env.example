# Talukdar Shop — environment variables
# Copy to .env.local and fill in. The app runs on demo data without these.

# Supabase (database) — get from https://supabase.com dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary (product/banner images) — get from https://cloudinary.com console
# Create an UNSIGNED upload preset (Settings → Upload → Upload presets) and put its name here.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Admin panel password (used for /admin login)
ADMIN_PASSWORD=talukdar-admin-2026
ADMIN_SESSION_SECRET=change-this-to-a-long-random-string

# Public site URL (for sitemap, canonical, OG)
NEXT_PUBLIC_SITE_URL=https://talukdar-shop.vercel.app
